APP_TIMEZONE=UTC
APP_DEBUG=true
APP_ERROR_REPORTING=display_errors
APP_MAINTENANCE=false
# Comma-separated paths that stay reachable while APP_MAINTENANCE=true (default: /health,/ready)
APP_MAINTENANCE_BYPASS_PATHS=
# Send Strict-Transport-Security only when APP_HSTS_ENABLED=true and the request is HTTPS (or X-Forwarded-Proto: https from a peer listed in APP_TRUSTED_PROXIES)
APP_HSTS_ENABLED=false
# Optional override for the HSTS header value
APP_HSTS_VALUE="max-age=31536000; includeSubDomains"
# Optional full Content-Security-Policy value (leave empty for demo sites that load third-party fonts/CDNs)
APP_SECURITY_CSP=
# Comma-separated proxy peers (IPv4/IPv6 address or CIDR, e.g. 10.0.0.0/8,::1) whose X-Forwarded-Proto is believed; empty means no proxy is trusted and the header is ignored
APP_TRUSTED_PROXIES=
ROUTE_CACHE=false
# Optional override for compiled route cache output (default: App/Cache/routes.cache.php)
ROUTE_CACHE_PATH=
IS_DEBUGGABLE=false
PROFILER_ENABLED=false
USE_PROXY=true

# Public origin for OAuth redirects and absolute URLs (no trailing slash)
APP_PUBLIC_URL=http://localhost:8080
# Optional bind for PHP built-in server (e.g. 0.0.0.0:8080); wired in root/index.php
APP_SERVER=
# Kernel stack root/index.php builds: `runtime` (default) = Framework\Component\Runtime -> Mapper,
# services from root/App/Configure/dependencies.php. `application` = Component\Foundation\Application
# -> Component\Kernel\HttpKernel, services from src/Service/*ServiceProvider.php. An unrecognised
# value is refused at startup rather than falling back. See AGENTS.md "Entry point".
APP_ENTRY_POINT=runtime

# i18n (Translator prefers APP_LOCALE, then APP_LANGUAGE / APP_LANG)
APP_LOCALE=
APP_LANGUAGE=
APP_LANG=
APP_FALLBACK_LOCALE=
APP_FALLBACK_LANGUAGE=

# Structured JSON kernel logging (default true when unset)
STRUCTURED_LOG_ENABLED=true

# Docker PHP: `db` + 3306. VS Code / host PHP: copy `.env.local.example` → `.env.local` (localhost:3308). Containers skip `.env.local` via RUNNING_IN_DOCKER.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=root

# Naver Papago (src/Command/PapagoCommand.php) and Naver Login (root/App/Configure/dependencies.php)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URL=

# Kakao Login redirect override (default: absolute URL to /kakaoAuth)
KAKAO_REDIRECT_URL=

# CLI integrations (src/Command/ClaudeCommand.php, ChatGPTCommand.php)
CLAUDE_API_KEY=
CHATGPT_API_KEY=

KOREA_PUBLIC_DATA_API_KEY=
NASA_API_KEY=
GEMINI_API_KEY=
JYOGAKUEN_LOGIN_TOKEN=
KAKAO_NATIVE_APP_KEY=
KAKAO_RESTFUL_API_KEY=
KAKAO_JAVASCRIPT_KEY=
KAKAO_ADMIN_KEY=
KAKAO_LOGIN_CLIENT_SECRET=
YOUTUBE_API_KEY=
BLOCKIO_API_KEY=
OPEN_DART_API_KEY=
EXHENTAI_IPB_MEMBER_ID=
EXHENTAI_IPB_PASS_HASH=
EXHENTAI_IGNEOUS=
EXHENTAI_S=
